# Environment Variables

Copy this file to `.env` and fill in your credentials.

## Required

# Public WebSocket URL for Twilio to connect back to (use ngrok for local dev)
VOICE_STREAM_URL=https://your-ngrok-url.ngrok.io

## Twilio (required for outbound calls and SMS)

TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

## ElevenLabs (required for ElevenLabs TTS/STT)

ELEVENLABS_API_KEY=your_elevenlabs_api_key

# Optional: override defaults
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM   # default: Rachel
# ELEVENLABS_MODEL=eleven_multilingual_v2
# STT_MODEL_ID=scribe_v2_realtime
# STT_LANGUAGE_CODE=en

## Azure Speech (required for Azure TTS/STT)

AZURE_SPEECH_KEY=your_azure_speech_key
# AZURE_SPEECH_REGION=westeurope           # default: westeurope
# AZURE_TTS_VOICE=en-US-JennyNeural        # default: fi-FI-NooraNeural

## Server

# VOICE_SERVER_PORT=8080                   # default: 8080

## Optional monitoring

# VOICE_MONITOR=1                          # enable AudioMixer real-time playback
