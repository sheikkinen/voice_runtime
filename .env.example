# Environment Variables

Copy this file to `.env` and fill in your credentials.

## Required

# Public WebSocket URL for Twilio to connect back to (use ngrok for local dev)
VOICE_STREAM_URL=https://your-ngrok-url.ngrok.io

## Twilio (required for outbound calls and SMS)

TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

## ElevenLabs (required for ElevenLabs TTS/STT)

ELEVENLABS_API_KEY=your_elevenlabs_api_key

# Optional: override defaults
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM   # default: Rachel
# ELEVENLABS_MODEL=eleven_multilingual_v2
# STT_MODEL_ID=scribe_v2_realtime
# STT_LANGUAGE_CODE=en

## Azure Speech (required for Azure TTS/STT)

AZURE_SPEECH_KEY=your_azure_speech_key
# AZURE_SPEECH_REGION=westeurope           # default: westeurope
# AZURE_TTS_VOICE=en-US-JennyNeural        # default: fi-FI-NooraNeural
# VR-009: comma-separated full locales; 2+ = continuous language ID,
# 1 = that locale only, unset = language_code. Max 10, one per base language.
# AZURE_STT_LANGUAGES=fi-FI,sv-SE,en-GB

## Google Chirp 3 (VR-013; requires the `google` extra and ADC credentials)

# GOOGLE_SPEECH_PROJECT=your-gcp-project   # falls back to GOOGLE_CLOUD_PROJECT
# GOOGLE_SPEECH_LOCATION=eu                # default: eu
# GOOGLE_STT_MODEL=chirp_3                 # default: chirp_3
# GOOGLE_STT_LANGUAGE=fi-FI                # default: fi-FI
# GOOGLE_STT_PHRASES=Terveystalo,Kela      # comma-separated phrase hints
# GOOGLE_STT_ENDPOINTING=supershort        # supershort | short | standard
# GOOGLE_TTS_VOICE=fi-FI-Chirp3-HD-Charon  # Chirp 3 HD voices only

## Server

# VOICE_SERVER_PORT=8080                   # default: 8080

# NC-283: Twilio signature validation
# TWILIO_SKIP_SIGNATURE_VALIDATION=1       # NEVER set in production; bypasses X-Twilio-Signature check

## Optional monitoring

# VOICE_MONITOR=1                          # enable AudioMixer real-time playback
